# Telezon S3 — copy to .env and edit.
# Deploy guide: docs/DEPLOY.zh-CN.md

# --- Step 1: service ---
PROJECT_NAME='Telezon S3'
# Listen port inside the app process. Release docker-compose maps host ${PORT}:8000 and sets PORT=8000 in the container.
PORT=8000
# Required: ≥16 chars, not placeholder. Generate: openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-string

# --- Step 2: MySQL (compose db service or your existing instance) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=telezon
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=TelezonS3
# DATABASE_URL=mysql://user:pass@host:3306/TelezonS3  (URL-encode @ # : etc. in password; or use MYSQL_* only)
# Built-in Compose sets MYSQL_HOST=db on the app service; app builds mysql+aiomysql:// from MYSQL_* when DATABASE_URL is unset

# --- Step 3: Telegram (https://my.telegram.org/apps) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Leave empty until after interactive login (docker compose --profile setup run --rm setup)
SESSION_STRING=
# Default storage channel/group id (optional helper during setup prints CID)
CID=
# Optional SOCKS5/HTTP proxy for Telegram (account + bot API).
# Home NAS: proxy often runs on the host or another LAN machine — do NOT use 127.0.0.1 inside the container.
# Use LAN IP, e.g. TELEGRAM_PROXY=socks5://192.168.1.10:7890
# Or host gateway (deploy/docker-compose.yml sets extra_hosts host.docker.internal):
# TELEGRAM_PROXY=socks5://host.docker.internal:7890
# TELEGRAM_PROXY=socks5://user:pass@192.168.1.10:1080

# --- Step 4: first admin (REST login, bucket name = username) ---
INITIAL_ADMIN_USER=admin
INITIAL_ADMIN_PASSWORD=change-me

# --- Optional: management bot (ENABLE_MGMT_BOT=1) or legacy bot storage scripts ---
# Account-mode S3 deploys do not need BOT_TOKEN. Leave unset unless ENABLE_MGMT_BOT=1.
# BOT_TOKEN=
TELEGRAM_API_BASE=
ENABLE_MGMT_BOT=0
TELEGRAM_ADMIN_IDS=
PUBLIC_BASE_URL=

# --- Ops / security ---
# Default 0: /api/health does not include database/telegram error strings.
# HEALTH_EXPOSE_ERRORS=1

# --- Reliability / limits ---
MAX_UPLOAD_BYTES=52428800
TG_RATE_LIMIT_PER_SEC=20
TG_RATE_BURST=20
TG_RATE_WAIT_SECONDS=30
# Local disk cache + MPU put-staging / mpu-staging (0.11.2+). Use one volume with enough free space.
CACHE_DIR=
CACHE_MAX_BYTES=536870912
APP_LANG=en
MULTIPART_MIN_PART_BYTES=5242880
MULTIPART_MAX_PARTS=10000
# 0.11: opaque TG document names (1=on), MPU album size, staging dir
TG_OPAQUE_FILENAMES=1
TG_ALBUM_MAX_ITEMS=10
# MPU_STAGING_DIR=
ENABLE_GC=1
GC_INTERVAL_SECONDS=3600
GC_MULTIPART_MAX_AGE_SECONDS=86400
GC_ORPHAN_SAMPLE_SIZE=20
ENABLE_TRASH=1
TRASH_RETENTION_SECONDS=604800
SHARE_MAX_FAILED_ATTEMPTS=5
SHARE_LOCKOUT_SECONDS=900
# Web console SPA at /console/ (build into app/static/console/)
ENABLE_CONSOLE=0
# Public self-service signup (console /api/auth/signup). Use 0 on internet-facing NAS.
ALLOW_SIGNUP=1
# Content preview ticket TTL (seconds, 60–3600; default 900)
MEDIA_TICKET_MAX_SECONDS=900
